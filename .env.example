# Copy to .env (never commit .env)
LLM_PROVIDER=openai            # openai (any OpenAI-compatible endpoint) | anthropic
LLM_MODEL=gpt-4o-mini          # change to whatever the organisers provide / allow
LLM_BASE_URL=                  # e.g. HUMAIN / Groq / Together / local vLLM endpoint; empty = OpenAI
LLM_API_KEY=
ANTHROPIC_API_KEY=
EVAL_WORKERS=8                 # lower this if you hit rate limits
LLM_CACHE_DIR=.cache/llm
